# Local configuration and credentials
.env
.env.*
!.env.example
insman_config.json
*_config.json
!insman_config.example.json
*.pem
*.key

# Runtime output, deployment and backups
/build/
/dist/
/exported_csv/
/exported_excel/
*.csv
*.xlsx
*.log
*_KingAPI.txt

# Build artifacts are ignored except for the published SDK and portable app.
*.dll
*.pyd
*.lib
*.jar
*.exe
*.zip
!/library/*.dll
!/library/*.lib
!/library/*.jar
!/portable/INSMAN/**
/portable/INSMAN/insman_config.json
/portable/INSMAN/exported_csv/
/portable/INSMAN/exported_excel/
/portable/INSMAN/**/*_KingAPI.txt
/portable/INSMAN/**/*.log
/portable/INSMAN/self_test_report.json

# Python / editor state
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
.vscode/
.idea/

# Compiled extensions are required by the portable Python runtime.
!/portable/INSMAN/**/*.pyd
